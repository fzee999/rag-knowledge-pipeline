# Copy to .env and adjust. Never commit .env.

# Chat model provider: ollama (local, free) or anthropic (Claude, needs an API key)
RAG_PROVIDER=ollama
# Ollama default: llama3.1:8b (run `ollama pull llama3.1:8b`). Claude default: claude-opus-5-5
RAG_MODEL=llama3.1:8b
# Ollama context window in tokens (passages + history must fit)
OLLAMA_NUM_CTX=16384
# Thinking models only (e.g. qwen3): true | false | low | medium | high. Leave empty for llama3.1.
OLLAMA_REASONING=

# Only for RAG_PROVIDER=anthropic
ANTHROPIC_API_KEY=
# Claude reasoning effort: low | medium | high | xhigh | max
RAG_EFFORT=medium

# Local embedding model (FastEmbed / ONNX, runs on CPU, no API key)
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# Vector store
CHROMA_DIR=.chroma
CHROMA_COLLECTION=documents

# Chunking + retrieval
CHUNK_SIZE=1000
CHUNK_OVERLAP=250
TOP_K=5

# Retrieval: vector | hybrid (BM25 + vector) | rerank (cross-encoder) | hybrid_rerank (best on the eval)
RETRIEVAL_MODE=hybrid_rerank
RETRIEVAL_CANDIDATES=20
RERANK_MODEL=Xenova/ms-marco-MiniLM-L-6-v2
